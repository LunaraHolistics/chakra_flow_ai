rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Catch-all: nada é permitido a menos que um bloco específico abaixo libere
    match /{document=**} {
      allow read, write: if false;
    }

    // Practitioner: escopo pelo campo userId (id do doc é livre)
    match /practitioners/{pid} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create:    if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update:    if signedIn() && resource.data.userId == request.auth.uid
                            && request.resource.data.userId == request.auth.uid;
      allow delete:    if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Clients
    match /clients/{cid} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create:    if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update:    if signedIn() && resource.data.userId == request.auth.uid
                            && request.resource.data.userId == request.auth.uid;
      allow delete:    if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Sessions (+ scores como subcoleção, defensivo)
    match /sessions/{sid} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create:    if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update:    if signedIn() && resource.data.userId == request.auth.uid
                            && request.resource.data.userId == request.auth.uid;
      allow delete:    if signedIn() && resource.data.userId == request.auth.uid;

      match /scores/{docId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sid)).data.userId == request.auth.uid;
      }
    }

    // Scores como coleção plana (defensivo, caso o app use este formato)
    match /session_chakra_scores/{docId} {
      allow get, list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create:    if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}